# --- Server ---
NODE_ENV=development
PORT=4000
# Public URL of the Next.js app (used for CORS and links in emails)
FRONTEND_URL=http://localhost:3000

# --- Database ---
# MySQL / MariaDB. URL-encode special characters in the password (@ -> %40, ! -> %21).
# connection_limit keeps shared hosting (which caps connections per user) happy.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DBNAME?connection_limit=5"
# Local server that only allows socket logins (Homebrew MariaDB): mysql://you@localhost:3306/DBNAME?socket=/tmp/mysql.sock

# --- Auth (Module 6) ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_HOURS=12
# Proxy hops in front of the API (affects client IPs used for login rate limiting)
TRUST_PROXY_HOPS=1

# --- Cloudinary: image uploads (leave all three blank in development to use local disk; REQUIRED in production) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email via Resend (Module 9) ---
RESEND_API_KEY=
EMAIL_FROM="Shree Foods <orders@example.com>"
# Local-disk upload folder used when Cloudinary is not configured (development only)
UPLOAD_DIR=./uploads

# Shared secret so the API can tell the web app to refresh its cached content after a CMS save.
# Must match REVALIDATE_SECRET in the frontend. Generate with: openssl rand -hex 24
REVALIDATE_SECRET=

# Cloudflare R2 image storage (all five, or none for local disk in development)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
